+type ToolCall = NonNullable<AIMessage["tool_calls"]>[number];
+
+/** A tool message's text, whether its content is a string or a list of content blocks. */
+function resultText(message: ToolMessage | undefined): string | undefined {
+  if (!message) return undefined;
+  const content = message.content as unknown;
+  if (typeof content === "string") return content;
+  if (Array.isArray(content)) {
+    return content
+      .map((block) =>
+        typeof block === "string"
+          ? block
+          : block && typeof block === "object" && "text" in block
+            ? String((block as { text: unknown }).text)
+            : "",
+      )
+      .join("");
+  }
+  return content == null ? "" : JSON.stringify(content);
+}
+
+function parsed(text: string): unknown {
+  try {
+    return JSON.parse(text);
+  } catch {
+    return text;
+  }
+}
+
+function short(value: unknown): string {
+  if (value === null || value === undefined) return "none";
+  if (Array.isArray(value)) return `${value.length} items`;
+  if (typeof value === "object") return "…";
+  return String(value);
+}
+
+/** One line that says what came back, for the closed row. */
+function preview(value: unknown, args: Record<string, unknown>): string {
+  if (value === "" || (Array.isArray(value) && value.length === 0)) {
+    return "no records";
+  }
+  if (Array.isArray(value)) {
+    return value.length === 1 ? "1 record" : `${value.length} records`;
+  }
+  if (value && typeof value === "object") {
+    return Object.entries(value)
+      .filter(([key]) => !(key in args))
+      .slice(0, 3)
+      .map(([key, inner]) => `${key}: ${short(inner)}`)
+      .join(" · ");
+  }
+  return String(value ?? "");
+}
+
+function pretty(value: unknown): string {
+  return typeof value === "string" ? value : JSON.stringify(value, null, 2);
+}
+
+function Block({ label, children }: { label: string; children: string }) {
+  return (
+    <div>
+      <div className="mb-1 text-[11px] font-medium tracking-wide text-gray-500 uppercase">
+        {label}
+      </div>
+      <pre className="max-h-72 overflow-auto rounded-md bg-gray-50 p-3 font-mono text-xs leading-relaxed whitespace-pre-wrap text-gray-800">
+        {children}
+      </pre>
+    </div>
+  );
+}
+
+function CallRow({ call, result }: { call: ToolCall; result?: string }) {
+  const [open, setOpen] = useState(false);
+  const args = (call.args ?? {}) as Record<string, unknown>;
+  const hasArgs = Object.keys(args).length > 0;
+  const value = result === undefined ? undefined : parsed(result);
+  const summary = hasArgs
+    ? Object.entries(args)
+        .map(([key, inner]) => `${key}: ${short(inner)}`)
+        .join(", ")
+    : "";
+
+  return (
+    <div>
+      <button
+        type="button"
+        onClick={() => setOpen(!open)}
+        className="flex w-full cursor-pointer items-center gap-2 px-3 py-2 text-left text-sm hover:bg-gray-50"
+      >
+        {result === undefined ? (
+          <Loader2 className="size-3.5 shrink-0 animate-spin text-gray-400" />
+        ) : (
+          <Check className="size-3.5 shrink-0 text-emerald-600" />
+        )}
+        <span className="shrink-0 font-mono text-[13px] font-medium text-gray-900">
+          {call.name}
+        </span>
+        {summary && (
+          <span className="shrink-0 font-mono text-xs text-gray-500">
+            {summary}
+          </span>
+        )}
+        <span className="min-w-0 flex-1 truncate text-right text-xs text-gray-500">
+          {value === undefined ? "running" : preview(value, args)}
+        </span>
+        <ChevronRight
+          className={cn(
+            "size-4 shrink-0 text-gray-400 transition-transform",
+            open && "rotate-90",
+          )}
+        />
+      </button>
+      {open && (
+        <div className="flex flex-col gap-3 border-t border-gray-100 px-3 py-3">
+          {hasArgs && <Block label="Arguments">{pretty(args)}</Block>}
+          {value !== undefined && <Block label="Result">{pretty(value)}</Block>}
+        </div>
+      )}
+    </div>
+  );
+}
+
+const ACTIONS: Record<string, { label: string; tone: string }> = {
+  cash_refund: { label: "Cash refund", tone: "bg-emerald-50 text-emerald-700 ring-emerald-200" },
+  account_credit: { label: "Account credit", tone: "bg-sky-50 text-sky-700 ring-sky-200" },
+  deny: { label: "Deny", tone: "bg-rose-50 text-rose-700 ring-rose-200" },
+  escalate: { label: "Escalate", tone: "bg-amber-50 text-amber-800 ring-amber-200" },
+  no_action: { label: "No action", tone: "bg-gray-100 text-gray-700 ring-gray-200" },
+};
+
+/** The agent's decision, which is the one tool call a reader has to be able to read at a glance. */
+function Proposal({ call, result }: { call: ToolCall; result?: string }) {
+  const args = (call.args ?? {}) as Record<string, any>;
+  const action = ACTIONS[args.action] ?? {
+    label: String(args.action ?? "?"),
+    tone: "bg-gray-100 text-gray-700 ring-gray-200",
+  };
+  const sections: string[] = Array.isArray(args.sections) ? args.sections : [];
+  const state =
+    result === undefined
+      ? { text: "Waits for a person", tone: "text-amber-700" }
+      : result.includes("reviewer replaced")
+        ? { text: "Recorded with a reviewer's changes", tone: "text-emerald-700" }
+        : result.includes("Recorded")
+          ? { text: "Recorded", tone: "text-emerald-700" }
+          : { text: "Sent back by a reviewer", tone: "text-rose-700" };
+
+  return (
+    <div className="overflow-hidden rounded-lg border border-gray-200 bg-white">
+      <div className="flex flex-wrap items-center gap-3 border-b border-gray-100 px-4 py-3">
+        <span className="text-[11px] font-medium tracking-wide text-gray-500 uppercase">
+          Proposal
+        </span>
+        <span
+          className={cn(
+            "rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset",
+            action.tone,
+          )}
+        >
+          {action.label}
+        </span>
+        <span className="text-base font-semibold text-gray-900 tabular-nums">
+          {"$"}
+          {((Number(args.amount_cents) || 0) / 100).toLocaleString("en-US", {
+            minimumFractionDigits: 2,
+            maximumFractionDigits: 2,
+          })}
+        </span>
+        {sections.length > 0 && (
+          <span className="text-xs text-gray-500">
+            Policy {sections.map((s) => `§${s}`).join(", ")}
+          </span>
+        )}
+        <span className={cn("ml-auto text-xs font-medium", state.tone)}>
+          {state.text}
+        </span>
+      </div>
+      {args.rationale && (
+        <p className="px-4 py-3 text-sm leading-relaxed text-gray-700">
+          {String(args.rationale)}
+        </p>
+      )}
+    </div>
+  );
